---
import Base from '../layouts/Base.astro';
import { prepHtml, cleanTitle, smarten, venueHtml } from '../lib/prepHtml';
import researchBio from '../../data/research-bio.json';
import pubData from '../../data/publications.json';

const bio = researchBio;
const bioHtml = prepHtml(bio.text);

function isPublished(item: { published?: boolean }) {
  return !item || item.published !== false;
}

const publications = (pubData.items || []).filter(isPublished);
const wip = (pubData.wip || []).filter(isPublished);

const pubCategories = [
  { types: ['Book'],              label: 'Books' },
  { types: ['Article', 'Chapter'], label: 'Articles and Chapters' },
  { types: ['Editor'],           label: 'Editor' },
  { types: ['Review'],           label: 'Reviews' },
] as const;

// Build WIP groups preserving insertion order
const wipGroupOrder: string[] = [];
const wipGroupMap: Record<string, typeof wip> = {};
wip.forEach(p => {
  const key = p.status || 'In preparation';
  if (!wipGroupMap[key]) { wipGroupMap[key] = []; wipGroupOrder.push(key); }
  wipGroupMap[key].push(p);
});

function pubYear(year: string | number | undefined) {
  const raw = year ? String(year) : '';
  if (raw === 'Forthcoming') return 'forthcoming';
  if (raw === 'Online first') return 'online first';
  return raw;
}

function volStr(p: { volume?: string; issue?: string; pages?: string }) {
  if (p.volume || p.issue) {
    const vi = p.volume
      ? (p.issue ? `${p.volume}(${p.issue})` : p.volume)
      : `(${p.issue})`;
    return vi + (p.pages ? `: ${p.pages}` : '');
  }
  return p.pages || '';
}
---

<Base title="Research | Romy Eskens" description="Publications and research by Romy Eskens, philosopher at Utrecht University." page="research" heading="Publications">

  {bio.text && (
    <div class="research-bio-wrap">
      <div
        class:list={['research-bio', 'bio-clamp', { 'is-justified': bio.justify }]}
        id="research-bio"
        set:html={bioHtml}
      />
      <button class="bio-toggle" type="button" onclick="_toggleBio(this)" aria-expanded="false" aria-controls="research-bio" data-open="Read more" data-close="Read less">Read more</button>
    </div>
  )}

  {pubCategories.map(({ types, label }) => {
    const items = publications.filter(p => (types as readonly string[]).includes(p.type || 'Article'));
    if (!items.length) return null;
    return (
      <>
        <h2 class="section-label">{label}</h2>
        <ul class="pub-list">
          {items.map((p, i) => {
            const absId = `abs-${label.replace(/\s+/g, '-').toLowerCase()}-${i}`;
            const vol = volStr(p);
            const citationParts = [p.journal ? `<em>${p.journal}</em>` : '', vol].filter(Boolean);
            const citation = citationParts.join(' ');
            const volHtml = vol ? `<span class="nobr">${vol.replace(/(\d)-(\d)/g, '$1–$2')}</span>` : '';
            const citationHtml = [venueHtml(p.journal), volHtml].filter(Boolean).join(' ');
            return (
              <li class="pub">
                <div class:list={['yr', { 'yr--word': !/^\d/.test(pubYear(p.year)) }]}>{pubYear(p.year)}</div>
                <div>
                  <h3>{cleanTitle(p.title)}{p.coauthors && <span class="coauthor"> with {p.coauthors}</span>}</h3>
                  {citation && <p class="venue" set:html={citationHtml + '.'} />}
                  {(p.abstract || p.pdf || p.doi || p.prize) && (
                    <div class="pub-links">
                      {p.abstract && (
                        <button type="button" class="abs-toggle" aria-expanded="false" aria-controls={absId} data-open="Abstract" data-close="Hide abstract" onclick={`_toggleAbstract('${absId}',this)`}>Abstract</button>
                      )}
                      {p.pdf && <a href={p.pdf} target="_blank" rel="noopener">PDF</a>}
                      {p.doi && <a href={p.doi} target="_blank" rel="noopener">Publisher</a>}
                      {p.prize && <span class="award-inline">{p.prize}</span>}
                    </div>
                  )}
                  {p.abstract && (
                    <div class="pub-abstract" id={absId} hidden>
                      <div class="pub-abstract-inner">{p.abstract}</div>
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </>
    );
  })}

  {wip.length > 0 && (
    <div id="wip">
      {wipGroupOrder.map((status, gi) => (
        <>
          <h2 class="section-label wip-group-label">{status}</h2>
          <ul class="pub-list">
            {wipGroupMap[status].map((p, i) => {
              const absId = `abs-wip-${gi}-${i}`;
              return (
                <li class="pub pub--wip">
                  <div class="yr"></div>
                  <div>
                    <h3 class="wip-title">{cleanTitle(p.title)}.</h3>
                    {(p.abstract || p.pdf) && (
                      <div class="pub-links">
                        {p.abstract && (
                          <button type="button" class="abs-toggle" aria-expanded="false" aria-controls={absId} data-open="Abstract" data-close="Hide abstract" onclick={`_toggleAbstract('${absId}',this)`}>Abstract</button>
                        )}
                        {p.pdf && <a href={p.pdf} target="_blank" rel="noopener">Draft PDF</a>}
                      </div>
                    )}
                    {p.abstract && (
                      <div class="pub-abstract" id={absId} hidden>
                        <div class="pub-abstract-inner">{p.abstract}</div>
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </>
      ))}
    </div>
  )}
</Base>
