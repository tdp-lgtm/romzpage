---
import Base from '../layouts/Base.astro';
import cvOrderJson from '../../data/cv-order.json';
import { buildSections, contactHtml, contactAddr } from '../lib/cv';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sectionsMap = buildSections(false);

// Section rows: { section, hidden? }. Only listed, non-hidden sections render.
const sectionOrder: string[] = ((cvOrderJson.sections || []) as any[])
  .map((s: any) => (typeof s === 'string' ? { section: s } : s))
  .filter((s: any) => s.section && s.hidden !== true)
  .map((s: any) => s.section);

const orderedSections = sectionOrder.filter(k => sectionsMap[k]).map(k => sectionsMap[k]);
---

<Base title="CV — Romy Eskens" description="Curriculum vitae of Romy Eskens — positions, education, publications, and presentations." page="cv" heading="Romy Eskens">
  <div class="cv-actions no-print">
    <a class="cv-download" href={`${base}/assets/cv.pdf`} target="_blank" rel="noopener">&#8595; Full CV</a>
    <a class="cv-download" href={`${base}/assets/cv-short.pdf`} target="_blank" rel="noopener">&#8595; Short CV</a>
  </div>

  <p id="cv-contact" class="cv-contact">
    <span set:html={contactHtml} />
    {contactAddr && <span class="cv-contact-addr">{contactAddr}</span>}
  </p>

  {orderedSections.map(sec => {
    if (!sec) return null;
    if (sec.key === 'wip' && !sec.content) return null;
    if (sec.key === 'references' && !sec.content) return null;
    return (
      <div class="cv-section" data-cv-section={sec.key}>
        <span class="eyebrow">{sec.label}</span>
        {sec.key === 'references'
          ? <div id={sec.id || `cv-${sec.key}`} class="cv-references-grid" set:html={sec.content} />
          : <div id={sec.id || `cv-${sec.key}`} set:html={sec.content} />
        }
      </div>
    );
  })}
</Base>
