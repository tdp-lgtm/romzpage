---
import Base from '../layouts/Base.astro';
import { buildSections, contactHtml, contactAddr, SHORT_ORDER } from '../lib/cv';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sectionsMap = buildSections(true);
const orderedSections = SHORT_ORDER.filter(k => sectionsMap[k]).map(k => sectionsMap[k]);
---

<Base title="Short CV | Romy Eskens" description="Short curriculum vitae of Romy Eskens." page="cv" heading="Romy Eskens">
  <p id="cv-contact" class="cv-contact">
    <span set:html={contactHtml} />
    {contactAddr && <span class="cv-contact-addr">{contactAddr}</span>}
  </p>
  <p class="cv-pdfs no-print">PDF: <a href={`${base}/assets/cv.pdf`} target="_blank" rel="noopener">Full CV</a> · <a href={`${base}/assets/cv-short.pdf`} target="_blank" rel="noopener">Short CV</a></p>

  {orderedSections.map(sec => {
    if (!sec) return null;
    return (
      <div class="cv-section" data-cv-section={sec.key}>
        <h2 class="section-label">{sec.label}</h2>
        <div id={sec.id || `cv-${sec.key}`} set:html={sec.content} />
      </div>
    );
  })}
</Base>
