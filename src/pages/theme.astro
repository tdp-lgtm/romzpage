---
import Base from '../layouts/Base.astro';
import themeData from '../../data/theme.json';
import { SCHEMES, FONTS } from '../lib/theme';

// Unlisted preview gallery for the Pages CMS "Appearance" settings.
// Loads every catalogue font so each specimen renders in its own typeface.
const previewFontUrls = [...new Set(
  Object.values(FONTS).flatMap(f => f.googleUrl ? [f.googleUrl] : [])
)];

const textFonts = Object.keys(FONTS).filter(n => n !== 'Same as text' && n !== 'Ysabeau Office' && !FONTS[n].sc && n !== 'Castoro Titling');
const headingFonts = [...textFonts, 'Castoro Titling'];
const labelFonts = ['Same as text', ...Object.keys(FONTS).filter(n => FONTS[n].sc)];
const figureFonts = ['Same as text', 'Ysabeau Office'];

const theme = themeData as Record<string, string>;
const currentScheme = theme.color_scheme || 'Graphite';
const cur = (a: string | undefined, b: string) => (a === b ? ' (current)' : '');
---

<Base title="Theme preview | Romy Eskens" page="theme" heading="Theme preview">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    {previewFontUrls.map(url => <link rel="stylesheet" href={url} />)}
  </Fragment>

  <p class="tp-intro">
    A visual reference for the options in <strong>Pages CMS → Appearance</strong>.
    Pick the names you like here, select them in the CMS, save, and the site rebuilds
    with your choices (about two minutes). This page isn’t linked from the navigation.
  </p>

  <div class="cv-section">
    <h2 class="section-label">Colour scheme</h2>
    {Object.entries(SCHEMES).map(([name, s]) => (
      <div class="tp-scheme" style={`background:${s.paper};border:1px solid ${s.rule}`}>
        <div class="tp-scheme-head">
          <strong style={`color:${s.ink}`}>{name}{cur(currentScheme, name)}</strong>
          <span class="tp-chips">
            {[s.paper, s.ink, s.fg2, s.fg3, s.rule, s.accent].map(c => (
              <span class="tp-chip" style={`background:${c}`} title={c} />
            ))}
          </span>
        </div>
        <p class="tp-sample" style={`color:${s.ink}`}>
          Body text looks like this, with <a style={`color:${s.link || s.accent}`} href="#">a hyperlink</a>,
          <span style={`color:${s.fg2}`}> secondary text for venues and dates,</span>
          <span style={`color:${s.fg3}`}> and quieter text for years.</span>
        </p>
      </div>
    ))}
    <p class="tp-note">Choosing <strong>Custom</strong> in the CMS uses the six hex-code fields instead.</p>
  </div>

  <div class="cv-section">
    <h2 class="section-label">Headings: page titles and section heads</h2>
    {headingFonts.map(name => (
      <p class="tp-specimen" style={`font-family:${FONTS[name].stack};font-size:1.75rem;line-height:1.2`}>
        <span class="tp-specimen-name">{name}{cur(theme.font_display, name)}</span>
        Publications, Talks and Teaching
      </p>
    ))}
  </div>

  <div class="cv-section">
    <h2 class="section-label">Text: reading text, titles and abstracts</h2>
    {textFonts.map(name => (
      <p class="tp-specimen" style={`font-family:${FONTS[name].stack}`}>
        <span class="tp-specimen-name">{name}{cur(theme.font_serif, name)}</span>
        On the ethics of self-defence and punishment: a quick brown fox jumps over the lazy dog, 1234567890.
      </p>
    ))}
  </div>

  <div class="cv-section">
    <h2 class="section-label">Labels: section heads and navigation</h2>
    {labelFonts.map(name => (
      <p class="tp-specimen" style={`font-family:${FONTS[name].stack};${FONTS[name].sc ? 'text-transform:lowercase' : ''}`}>
        <span class="tp-specimen-name" style="text-transform:none">{name}{cur(theme.font_sans, name)}</span>
        Research · Talks · Teaching · Public Philosophy · CV
      </p>
    ))}
  </div>

  <div class="cv-section">
    <h2 class="section-label">Figures: years, counts and amounts</h2>
    {figureFonts.map(name => (
      <p class="tp-specimen" style={`font-family:${FONTS[name].stack};font-variant-numeric:lining-nums tabular-nums`}>
        <span class="tp-specimen-name">{name}{cur(theme.font_mono, name)}</span>
        2026 · 2018–2022 · (×2) · €320,000
      </p>
    ))}
  </div>

  <div class="cv-section">
    <h2 class="section-label">Link underline style</h2>
    <p class="tp-specimen">
      <span class="tp-specimen-name">always{cur(theme.link_underline || 'always', 'always')}</span>
      Links in running text, like <a href="#" style="text-decoration:underline">this one</a>, are always underlined.
    </p>
    <p class="tp-specimen">
      <span class="tp-specimen-name">hover{cur(theme.link_underline, 'hover')}</span>
      Links like <a href="#" style="text-decoration:none">this one</a> are underlined only when you hover them.
    </p>
    <p class="tp-specimen">
      <span class="tp-specimen-name">none{cur(theme.link_underline, 'none')}</span>
      Links like <a href="#" style="text-decoration:none">this one</a> are never underlined (colour only).
    </p>
  </div>

  <div class="cv-section">
    <h2 class="section-label">Heading weight</h2>
    {['300', '400', '500', '600'].map(w => (
      <p class="tp-specimen">
        <span class="tp-specimen-name">{w}{cur(theme.heading_weight || '400', w)}</span>
        <span style={`font-family:var(--display);font-size:1.5rem;font-weight:${w}`}>Articles and Chapters</span>
      </p>
    ))}
  </div>

  <style>
    .tp-intro { color: var(--fg-2); max-width: 40rem; }
    .tp-scheme { padding: 0.9rem 1.1rem; margin: 0.75rem 0; }
    .tp-scheme-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
    .tp-chips { display: inline-flex; gap: 0.3rem; }
    .tp-chip { width: 1.15rem; height: 1.15rem; border-radius: 50%; display: inline-block; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.12); }
    .tp-sample { margin: 0.5rem 0 0; font-size: 0.95rem; }
    .tp-specimen { margin: 0.9rem 0; font-size: 1.05rem; line-height: 1.5; }
    .tp-specimen-name { display: block; font-family: var(--serif); font-style: italic; font-size: 0.875rem; color: var(--fg-3); margin-bottom: 0.2rem; }
    .tp-note { font-size: 0.9rem; color: var(--fg-3); }
  </style>
</Base>
