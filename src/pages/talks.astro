---
import Base from '../layouts/Base.astro';
import talksData from '../../data/talks.json';

function isPublished(item: { published?: boolean }) {
  return !item || item.published !== false;
}

const talks = ((talksData as any).items || talksData).filter(isPublished);

// Flatten every presentation into a single chronological list of events
// (no paper titles) — newest first.
type Ev = { year?: string; month?: string; venue?: string; institution?: string; type?: string; comment?: string };
const events: Ev[] = [];
talks.forEach((t: any) => (t.presentations || []).filter(isPublished).forEach((p: Ev) => events.push(p)));
events.sort((a, b) => (parseInt(String(b.year)) || 0) - (parseInt(String(a.year)) || 0));
---

<Base title="Talks — Romy Eskens" description="Talks and conference presentations by Romy Eskens." page="talks" heading="Talks">

  <ul class="pub-list">
    {events.map((p) => {
      const date = p.month ? `${p.month} ${p.year}` : String(p.year || '');
      const where = [p.venue, p.institution].filter(Boolean).join(', ');
      const tag = p.type === 'Invited' ? 'Invited'
        : p.type === 'Peer-Review' ? 'Peer-reviewed' : '';
      return (
        <li class="event-row">
          <div class="yr">{date}</div>
          <div class="event-detail">
            {where}{tag && <span class="talk-tag">{tag}</span>}
            {p.comment && <em class="talk-comment"> {p.comment}</em>}
          </div>
        </li>
      );
    })}
  </ul>
</Base>
