---
interface SubItem {
  label: string;
  href: string;
}
interface NavItem {
  label: string;
  href?: string;
  subitems?: SubItem[];
}
interface Props {
  items: NavItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

// Strip base prefix and trailing slash for comparison
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // e.g. '/websnewflow' or ''
const path = currentPath.replace(base, '').replace(/\/$/, '') || '/';

function makeHref(slug: string): string {
  const clean = slug.replace(/\.html$/, '');
  if (clean === '' || clean === 'index') return import.meta.env.BASE_URL;
  return `${base}/${clean}`;
}

function isActive(href: string): boolean {
  const clean = href.replace(/\.html$/, '');
  if (clean === '' || clean === 'index') return path === '/';
  return path === '/' + clean || path === '/' + clean + '/';
}

function isDropdownActive(item: NavItem): boolean {
  const subs = item.subitems || [];
  if (subs.some(s => isActive(s.href))) return true;
  return subs.some(s => {
    const clean = s.href.replace(/\.html$/, '');
    return path.startsWith('/' + clean);
  });
}
---

<nav aria-label="Main">
  {items.map(item => {
    if (item.subitems && item.subitems.length > 0) {
      const active = isDropdownActive(item);
      const dropKey = item.label.toLowerCase();
      const menuId = `nav-menu-${dropKey.replace(/[^a-z0-9]+/g, '-')}`;
      return (
        <div class={`nav-dropdown${active ? ' active' : ''}`} data-dropdown-root>
          <button class="nav-dropdown-trigger" type="button" data-dropdown={dropKey} aria-expanded="false" aria-controls={menuId}>{item.label}</button>
          <ul class="nav-dropdown-menu" id={menuId}>
            {item.subitems.map(s => {
              const subActive = isActive(s.href) || path.startsWith('/' + s.href.replace(/\.html$/, '') + '/');
              return (
                <li><a href={makeHref(s.href)} aria-current={subActive ? 'page' : undefined}>{s.label}</a></li>
              );
            })}
          </ul>
        </div>
      );
    }
    const href = item.href ? makeHref(item.href) : (base || '/');
    const active = item.href ? isActive(item.href) : (path === '/');
    return (
      <a href={href} aria-current={active ? 'page' : undefined}>{item.label}</a>
    );
  })}
</nav>

<script>
  function closeAll(except?: Element | null) {
    document.querySelectorAll('[data-dropdown-root].open').forEach(d => {
      if (d === except) return;
      d.classList.remove('open');
      d.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
    });
  }
  function initNav() {
    document.querySelectorAll<HTMLButtonElement>('.nav-dropdown-trigger').forEach(trigger => {
      trigger.onclick = (e) => {
        e.stopPropagation();
        const dropdown = trigger.closest('[data-dropdown-root]');
        if (!dropdown) return;
        closeAll(dropdown);
        const open = dropdown.classList.toggle('open');
        trigger.setAttribute('aria-expanded', String(open));
      };
    });
  }
  // Phone menu: the hamburger opens and closes the whole nav
  const sidebar = document.querySelector('.sidebar');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  function setMenu(open: boolean) {
    sidebar?.classList.toggle('nav-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
  }
  if (toggle) toggle.onclick = (e) => {
    e.stopPropagation();
    setMenu(!sidebar?.classList.contains('nav-open'));
  };
  // Close on outside click or Escape
  document.addEventListener('click', (e) => {
    closeAll();
    if (sidebar && !sidebar.contains(e.target as Node)) setMenu(false);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeAll(); setMenu(false); } });
  initNav();
</script>
