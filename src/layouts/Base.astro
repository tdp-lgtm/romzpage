---
import Nav from '../components/Nav.astro';
import navData from '../../data/nav.json';
import projectsData from '../../data/projects.json';
import themeData from '../../data/theme.json';
import settings from '../../data/site-settings.json';
import { getThemeCss, getThemeFontLinks } from '../lib/theme';

const themeCss = getThemeCss(themeData as Record<string, string>);
const fontLinks = getThemeFontLinks(themeData as Record<string, string>);

interface Props {
  title: string;
  description?: string;
  page?: string;
  wideLayout?: boolean;
  heading?: string;
}

const { title, description, page, wideLayout = false, heading } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// On the home page and the CV the h1 is the name itself; the sidebar already
// shows it on screen, so the h1 is visually hidden there (it still prints).
const isNamePage = heading === settings.title;

// Published research projects each get a page at /research/<id>. When any
// exist, the flat "Research" nav link becomes a group (Publications + each
// project) so new projects show up automatically without editing nav.json.
const projects = (((projectsData as any).items) || []).filter((p: any) => p && p.published !== false);
const navItems = (navData.items as any[]).map(item => {
  if ((item.label || '').toLowerCase() === 'research' && projects.length > 0) {
    return {
      ...item,
      href: undefined,
      subitems: [
        { label: 'Publications', href: 'research' },
        ...projects.map((p: any) => ({ label: p.title, href: `research/${p.id}` })),
      ],
    };
  }
  return item;
});

const metaDesc = description || settings.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(settings.og_image || '/assets/portrait.jpg', Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={metaDesc} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImageURL} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDesc} />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}/assets/favicon-32.png`} />
  <link rel="icon" type="image/png" sizes="192x192" href={`${base}/assets/favicon-192.png`} />
  <link rel="apple-touch-icon" href={`${base}/assets/apple-touch-icon.png`} />
  <link rel="stylesheet" href={`${base}/styles/style.css`} />
  {fontLinks.length > 0 && <link rel="preconnect" href="https://fonts.googleapis.com" />}
  {fontLinks.length > 0 && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
  {settings.analytics_id && <link rel="preconnect" href="https://gateway.umami.is" />}
  {fontLinks.map(url => <link rel="stylesheet" href={url} />)}
  <Fragment set:html={`<style>${themeCss}</style>`} />
  <slot name="head" />
</head>
<body data-page={page}>

  <aside class="sidebar no-print">
    <div class="side-head">
      <a class="side-name" href={base || '/'}>{settings.title}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
        <span class="menu-icon" aria-hidden="true"></span>
      </button>
    </div>
    <div class="site-nav" id="site-nav">
      <Nav items={navItems} currentPath={currentPath} />
    </div>
  </aside>

  <main>
    <div class={wideLayout ? 'container' : 'narrow'}>
      <div class={`masthead${isNamePage ? ' masthead--name' : ''}`}>
        {heading && <h1 class:list={['page-title', { 'is-name': isNamePage }]}>{heading}</h1>}
      </div>
      <slot />
    </div>
  </main>

  <footer>
    <div class="foot-inner">
      <nav class="foot-links" aria-label="Contact and links">
        {settings.quick_links.map((link: any) => {
          const isMail = link.href.startsWith('mailto:');
          const href = link.href.startsWith('/') ? `${base}${link.href}` : link.href;
          const external = !link.href.startsWith('/') && !isMail;
          return (
            <a href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>{isMail ? link.href.replace('mailto:', '') : link.label}</a>
          );
        })}
      </nav>
    </div>
  </footer>

  <!-- Called via onclick attributes in static HTML, so these must be global -->
  <script is:inline>
    function _toggleAbstract(id, btn) {
      var el = document.getElementById(id);
      if (!el) return;
      var opening = el.hasAttribute('hidden');
      el.toggleAttribute('hidden', !opening);
      btn.setAttribute('aria-expanded', String(opening));
      btn.textContent = opening ? btn.dataset.close : btn.dataset.open;
    }
    function _toggleBio(btn) {
      var el = btn.previousElementSibling;
      if (!el) return;
      var open = el.classList.toggle('open');
      btn.textContent = open ? (btn.dataset.close || 'Read less') : (btn.dataset.open || 'Read more');
      btn.setAttribute('aria-expanded', String(open));
    }
  </script>

  {settings.analytics_id && (
    <Fragment set:html={`<script defer src="https://cloud.umami.is/script.js" data-website-id="${settings.analytics_id}"></script>`} />
  )}

</body>
</html>
